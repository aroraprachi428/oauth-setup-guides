# Copy to .env.local and fill in. Never commit real values.

# Research agent: "gemini" for real runs, "demo" for the local scripted demo (dev only).
AGENT_MODEL=gemini
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash
GEMINI_MODEL=
# Optional: models to switch to when one's free daily quota runs out (comma-separated).
# Defaults to gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=
# Optional: Tavily web search as a fallback (free plan: 1,000 searches/month). Leave empty to run without search.
TAVILY_API_KEY=

# Guide store: a local file, or a Turso URL plus token when hosted.
STORE_URL=file:./data/guides.db
STORE_AUTH_TOKEN=

# Optional: also write published guides and full runs (model output, pages fetched) as JSON files
# under <dir>/guides and <dir>/runs. Local only; leave empty when hosted.
ARCHIVE_DIR=

# Salt for visitor hashes (any long random string). Required in production.
VISITOR_SECRET=

# Optional limits (defaults shown)
LIMIT_ADDS_PER_VISITOR=3
LIMIT_REPORTS_PER_VISITOR=5
LIMIT_RUNS_PER_DAY=50
